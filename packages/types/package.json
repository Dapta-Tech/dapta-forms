  },
  "dependencies": {
    "@quill/engine": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@quill/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
