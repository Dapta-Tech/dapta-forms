# ---------------------------------------------------------------------------
# Dapta Forms — example environment
# Copy to .env and adjust. A bare clone runs with NOTHING set here:
# SQLite file DB, log-only email, local dev auth. Zero infrastructure needed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Unset  -> SQLite at ./.data/dev.db (the default, zero-infra clone-and-run)
# file:… -> SQLite file
# A PostgreSQL connection URL selects Postgres in production. Keep credentials in `.env`.
# NOTE: the schema must be migrated before the API boots. `pnpm dev` / `pnpm dev:pg`
# do this for you (they run db:setup first). If you start an app directly against a
# fresh DB, run `pnpm db:migrate` first — otherwise the outbox worker fails with
# "no such table: outbox".
# DATABASE_URL=file:./.data/dev.db
# DATABASE_URL=

# --- API server -----------------------------------------------------------
# Port the NestJS API listens on (default 4000; local dev convention: 4400).
API_PORT=4400
# Public base URL of the web app, used to build public form links.
PUBLIC_APP_URL=http://localhost:3400

# --- Web app --------------------------------------------------------------
# Where the web app reaches the API from the server (RSC fetch). Default:
# http://localhost:4000 (local dev convention: 4400)
NEXT_PUBLIC_API_URL=http://localhost:4400

# The web mirrors the API's AUTH_PROVIDER to pick the right login UX (email form
# vs WorkOS redirect). Same values as the API's AUTH_PROVIDER. Unset -> local.
# AUTH_PROVIDER=local
#
# Signs/verifies the httpOnly `quill_session` cookie (server-only — never
# NEXT_PUBLIC_*). Unset in a bare fork = unsigned dev cookie; SET it for any
# real deployment so the session can't be forged.
# WEB_SESSION_SECRET=replace-with-a-long-random-string
#
# WorkOS provider only: base URL of the upstream IAM identity service that fronts
# WorkOS AuthKit and mints the platform JWT. The web calls it for the login URL,
# and redirects through its logout. Server-only; never a secret itself.
# IAM_BASE_URL=https://iam.example.internal

# --- Growth loop / branding (public pages) ---------------------------------
# When a signup destination is configured, public form pages carry a discreet
# "Made with Dapta Forms" footer badge. Open-core: unset (the bare-fork
# default) renders nothing — no upstream branding is forced on forks; the
# upstream cloud deployment sets its own signup URL.
# NEXT_PUBLIC_SIGNUP_URL=https://app.your-cloud.example
#
# Every badge/CTA link carries the UTM scheme
#   utm_source=dapta-forms
#   utm_medium=badge | confirmation        (which surface was clicked)
#   utm_campaign=made-with-dapta
#   utm_content=<accountCode>              (attribution only — already public in the page URL)
#
# Set to hide badge + CTA even when a signup URL is configured (1|true|yes).
# NEXT_PUBLIC_HIDE_BADGE=1

# --- Email / notifications ------------------------------------------------
# Provider selector. Unset or "log-only" -> emails are logged, not sent
# (a bare fork still runs submission flows end-to-end).
#   log-only | noop | smtp | http
EMAIL_PROVIDER=log-only
MAIL_FROM_EMAIL=forms@example.com
MAIL_FROM_NAME=Forms

# SMTP adapter (EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# HTTP mailer adapter (EMAIL_PROVIDER=http) — POSTs each message to an external
# email service. Wire it to any send endpoint; no provider is hardcoded.
# EMAIL_HTTP_ENDPOINT=https://email.example.com/api/send
#
# Wire/profile:
#   generic          — provider-agnostic JSON body + optional Bearer auth (default)
#   transactional-v1 — managed transactional contract + HMAC service auth
# EMAIL_HTTP_PROFILE=generic
# transactional-v1 requires the endpoint path `/api/internal/email/send`.
#
# generic profile: Bearer token.
# EMAIL_HTTP_TOKEN=
#
# transactional-v1 profile: a stable client id plus a server-only signing
# secret loaded from the deployment secret manager. The secret is never sent.
# EMAIL_HTTP_CLIENT_ID=forms
# EMAIL_HTTP_SIGNING_SECRET=
# EMAIL_HTTP_CATEGORY=lifecycle

# --- Submission destinations (CRM / webhook sync) ---------------------------
# Webhook destinations are configured per form in the admin UI (URL + optional
# HMAC secret) — nothing here. HubSpot destinations need a server-side private-
# app token; unset -> the HubSpot destination + property picker report a clear
# disabled state (a webhook-only deployment needs nothing here). Never sent to
# the browser.
# HUBSPOT_PRIVATE_APP_TOKEN=

# --- Premium entitlements (vanity slug; Forms itself is always free) --------
# open (default) -> every feature unlocked (a bare OSS fork gets everything).
# locked         -> premium gates on the upstream entitlement service below.
# PREMIUM_FEATURES=open
# ENTITLEMENTS_API_URL=
# ENTITLEMENTS_API_KEY=

# --- Outbox worker (durable submission emails + destination deliveries) -----
# OUTBOX_WORKER_ENABLED=true
# OUTBOX_POLL_MS=5000
# OUTBOX_MAX_ATTEMPTS=5

# --- CORS / rate limiting (public surface) ----------------------------------
# Comma-separated origin allowlist; unset -> the app's own web origin only.
# CORS_ORIGINS=https://acme.com,https://foo.io
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_REFILL_PER_SEC=1

# --- Auth (dashboard only; public form pages are always open) ---------------
# Unset -> local dev auth stub (a fork logs in without any external provider).
# AUTH_PROVIDER=local
#
# DEV ONLY: with AUTH_PROVIDER=local, log in as a specific email instead of the
# first seeded demo account. The stub resolves the member with this email and
# JIT-creates a fresh account+member if none exists. (A request may also carry
# `x-quill-email`, which overrides this.) Ignored in production.
# DEV_LOGIN_EMAIL=you@example.com
#
# DEV ONLY: strict local auth. When true, a request with no identity (no
# impersonation headers, no x-quill-email) returns 401 instead of falling back
# to the seeded account — giving local dev a real "logged out" state so the web
# login/logout flow can bounce to sign-in. Default false = always logged in.
# AUTH_LOCAL_STRICT=false
#
# AUTH_PROVIDER=workos validates a host session token minted by an upstream
# identity service: an HS256 JWT (claims: sub, account_id, email, name) signed
# with a shared secret. The SAME validation runs in local dev and remote because
# the secret is symmetric — nothing environment-specific to fetch. Selecting
# `workos` without JWT_SECRET fails loud (never falls back to the insecure stub).
# JWT_ISSUER / JWT_AUDIENCE are enforced only when set.
# AUTH_PROVIDER=workos
# JWT_SECRET=replace-with-your-shared-signing-secret
# JWT_ISSUER=your-identity-issuer
# JWT_AUDIENCE=your-platform-audience
#
# Offline dev: mint a token that this provider will accept (no identity server):
#   pnpm --filter @quill/api auth:mint -- --account acct_dev --sub user_dev
# then call the API with `Authorization: Bearer <token>`.
