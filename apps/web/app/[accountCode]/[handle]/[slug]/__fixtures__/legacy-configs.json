      },
      {
        "key": "problema",
        "type": "multiple_choice",
        "question": "[firstname], what problem are you solving?",
        "required": true,
        "options": [
          {
            "label": "Cold leads follow-up",
            "value": "leads_frios",
            "points": 2
          },
          {
            "label": "WhatsApp sales",
            "value": "whatsapp",
            "points": 2
          },
          {
            "label": "Customer support",
            "value": "soporte",
            "points": 1
          },
          {
            "label": "None of these",
            "value": "ninguna",
            "points": -5
          }
        ],
        "flowGroup": "qualification",
        "selectionMode": "single"
      },
      {
        "key": "inbound_leads",
        "type": "slider",
        "question": "How many leads per month?",
        "required": true,
        "min": 0,
        "max": 1500,
        "step": 10,
        "default": 100,
        "sliderScoring": [
          {
            "min": 0,
            "max": 99,
            "points": -2
          },
          {
            "min": 100,
            "max": 149,
            "points": -1
          },
          {
            "min": 150,
            "max": 299,
            "points": 1
          },
          {
            "min": 300,
            "max": 999,
            "points": 2
          },
          {
            "min": 1000,
            "max": 1500,
            "points": 3
          }
        ],
        "showWhen": {
          "field": "problema",
          "values": [
            "leads_frios",
            "whatsapp",
            "soporte"
          ]
        },
        "flowGroup": "qualification",
        "questionField": "problema",
        "questionVariants": {
          "leads_frios": "How many cold leads do you get per month?",
          "whatsapp": "How many WhatsApp conversations per month?",
          "*": "How many leads per month?"
        }
      },
      {
        "key": "industry",
        "type": "dropdown",
        "question": "What industry are you in?",
        "required": true,
        "options": [
          {
            "label": "Banking",
            "value": "banking",
            "points": 2
          },
          {
            "label": "Software",
            "value": "software",
            "points": 2
          },
          {
            "label": "Retail",
            "value": "retail",
            "points": 1
          },
          {
            "label": "Accounting",
            "value": "accounting",
            "points": -2
          },
          {
            "label": "Other industry",
            "value": "other",
            "points": 0
          }
        ],
        "hideWhen": {
          "field": "problema",
          "values": [
            "ninguna"
          ]
        },
        "flowGroup": "qualification"
      },
      {
        "key": "uso_ia",
        "type": "multiple_choice",
        "question": "Are you using AI today?",
        "required": true,
        "options": [
          {
            "label": "Yes, in production",
            "value": "production",
            "points": 1
          },
          {
            "label": "Experimenting",
            "value": "experimenting",
            "points": 1
          },
          {
            "label": "Not yet",
            "value": "no",
            "points": 0
          }
        ],
        "flowGroup": "qualification",
        "selectionMode": "single"
      },
      {
        "key": "email",
        "type": "email",
        "question": "What's your work email?",
        "required": true,
        "flowGroup": "lead_capture",
        "triggersReveal": true
      },
      {
        "key": "website",
        "type": "text",
        "question": "What's your company website?",
        "required": true,
        "flowGroup": "lead_capture",
        "showForPersonalEmailOnly": true
      },
      {
        "key": "disqualified_msg",
        "type": "message",
        "question": "We can't help you just yet, thanks for your time.",
        "required": false,
        "showWhen": {
          "field": "problema",
          "values": [
            "ninguna"
          ]
        },
        "flowGroup": "lead_capture",
        "terminal": true
      },
      {
        "key": "phone",
        "type": "phone",
        "question": "What's your phone number?",
        "required": true,
        "flowGroup": "lead_capture"
      }
    ],
    "cover": {
