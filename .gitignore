# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Local database (SQLite) & data
.data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment & secrets — NEVER commit real env or keys
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Internal deploy overlay — private, never in the public repo
/deploy/

# QA / screenshot dumps
.design-shots/
.design-shots-ux/
*-screenshots/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# internal deploy/auth docs — never publish (infra names)
WORKOS-STATUS.md
AUTH-WEB-CONTRACT.md
*-STATUS.md
.design-out/
# Critique snapshots from the `impeccable` skill — tool output, not source.
.impeccable/
.shots/

# e2e QA artifacts
qa/playwright-report/
qa/test-results/
test-results/
qa/shots/
# Any alternate Next build dir (NEXT_DIST_DIR) — one per worktree, so two
# checkouts can run dev side by side without fighting over .next/. Covers the
# QA runner's .next-qa/ too.
.next-*/

# Throwaway QA agent artifacts (screenshots + scratch specs)
qa/tmp-shots/
qa/e2e/tmp-*
